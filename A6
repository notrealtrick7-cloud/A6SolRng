local function TryCraft(npcKW, itemName, recipe)
    local part = GetNPCPart(npcKW)
    if not part then return false end
    WalkTo(part.Position+Vector3.new(0,0,3)); task.wait(0.4)
    PressP("Craft"); task.wait(0.3)
    for _, n in ipairs({"Craft","CraftItem","RequestCraft","BrewPotion","CraftPotion","CraftGauntlet"}) do
        FireR(n, itemName); FireR(n, itemName, recipe)
    end
    task.wait(0.7)
    return true
end

local function AutoCraftSelected()
    S.Craft = true
    -- Gauntlets đã chọn
    for _, name in ipairs(S.SelectedRight) do
        if not S.Craft then break end
        for _, g in ipairs(RIGHT_GAUNTLETS) do
            if g.name == name then TryCraft("Jake", g.name, g.recipe); break end
        end
    end
    for _, name in ipairs(S.SelectedLeft) do
        if not S.Craft then break end
        for _, g in ipairs(LEFT_GAUNTLETS) do
            if g.name == name then TryCraft("Jake", g.name, g.recipe); break end
        end
    end
    -- Potions đã chọn
    for _, name in ipairs(S.SelectedPotions) do
        if not S.Craft then break end
        for _, p in ipairs(STELLA_POTIONS) do
            if p.name == name then TryCraft("Stella", p.name, p.recipe); break end
        end
    end
    S.Craft = false
end

