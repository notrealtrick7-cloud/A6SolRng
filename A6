local function FindMerchant(color)
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") then
            local n=v.Name:lower()
            if color=="white" and (n:find("mari") or n:find("travel")) then return v end
            if color=="purple" and (n:find("jester") or n:find("black")) then return v end
        end
    end
end

local function TeleOrWalk(model)
    if not model then return end
    local p=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not p then return end
    if S.HasTelePass then
        FireR("MerchantTeleport"); FireR("TeleportToMerchant"); task.wait(1.5)
    else WalkTo(p.Position+Vector3.new(0,0,3)) end
end

local function HandleMari()
    local m=FindMerchant("white"); if not m then return end
    TeleOrWalk(m); task.wait(0.4)
    PressP("Shop"); PressP("Buy"); task.wait(0.3)
    for _, item in ipairs(MARI_BUY) do
        FireR("BuyItem",item); FireR("PurchaseItem",item,1); task.wait(0.2)
    end
end

local function HandleJester()
    local m=FindMerchant("purple"); if not m then return end
    TeleOrWalk(m); task.wait(0.4)
    PressP("Trade"); task.wait(0.3)
    local inv=LP:FindFirstChild("Backpack")
    if inv then
        for _, t in ipairs(inv:GetChildren()) do
            local amt=math.min(S.JAmount,9999)
            FireR("TradeItem",t.Name,amt); FireR("ExchangeItem",t.Name,amt); task.wait(0.2)
        end
    end
    FireR("BuyFromJester","OblivionPotion"); FireR("BuyFromJester","HeavenlyPotion")
    FireR("BuyFromJester","StellaStar"); task.wait(0.3)
end

local function HandleRin()
    local p=GetNPCPart("Rin"); if not p then return end
    if S.HasTelePass then FireR("MerchantTeleport"); task.wait(1)
    else WalkTo(p.Position+Vector3.new(0,0,3)) end
    task.wait(0.4); PressP("Quest"); PressP("Tail"); task.wait(0.3)
    local full=false
    pcall(function()
        local d=FireR("GetPlayerData")
        if d and d.TailCount and d.TailSlots then full=(d.TailCount>=d.TailSlots) end
    end)
    if not full then
        FireR("AcceptQuest","TailQuest"); FireR("StartTailQuest"); task.wait(0.4)
        for _=1,3 do FireR("CompleteTailQuest"); FireR("ClaimTailReward"); task.wait(0.5) end
    end
end

local function AutoMerchantLoop()
    S.HasTelePass=CheckPass(TELE_PASS)
    while S.Merchant do
        local m=S.MMode
        if m=="Mari" or m=="All" then HandleMari() end; task.wait(0.5)
        if m=="Jester" or m=="All" then HandleJester() end; task.wait(0.5)
        if m=="Rin" or m=="All" then HandleRin() end
        task.wait(3)
    end
end

