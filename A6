-- TAB 1 — AUTO FISH
-- Nguồn: progameguides, roonby 2026
-- Đứng gần ocean → Fish button hiện → reel bar → bán Captain Flarg
-- ============================================================

local OCEAN_SPOTS = {
    Vector3.new(-190,3,0), Vector3.new(190,3,0),
    Vector3.new(0,3,190),  Vector3.new(0,3,-190),
    Vector3.new(-150,3,150),Vector3.new(150,3,150),
    Vector3.new(-150,3,-150),Vector3.new(150,3,-150),
}

local function AutoFishLoop()
    while S.Fish do
        -- Tìm ocean spot gần nhất
        local best, bd = OCEAN_SPOTS[1], math.huge
        for _, v in ipairs(OCEAN_SPOTS) do
            local d=(Root.Position-v).Magnitude; if d<bd then bd=d;best=v end
        end
        WalkTo(best); task.wait(0.5)
        -- Nhấn Fish
        if not PressP("Fish") then
            for _, n in ipairs({"Fish","StartFishing","BeginFish","FishCast"}) do FireR(n) end
        end
        task.wait(0.4)
        -- Handle reel bar
        for i=1,30 do
            if not S.Fish then break end
            PressP("Reel"); PressP("Catch")
            FireR("ReelFish"); FireR("CatchFish"); FireR("CompleteFish")
            task.wait(0.1)
        end
        task.wait(0.3)
        -- Auto sell tại Captain Flarg mỗi ~10 lần
        if math.random(1,8)==1 then
            local flarg = GetNPCPart("Flarg") or GetNPCPart("FishNPC") or GetNPCPart("Captain")
            if flarg then
                WalkTo(flarg.Position+Vector3.new(0,0,3)); task.wait(0.3)
                PressP("Sell"); FireR("SellFish"); FireR("SellAllFish")
                task.wait(0.4)
            end
        end
    end
    -- Sell khi tắt
    local flarg=GetNPCPart("Flarg") or GetNPCPart("Captain")
    if flarg then WalkTo(flarg.Position+Vector3.new(0,0,3)); PressP("Sell"); FireR("SellAllFish") end
end

