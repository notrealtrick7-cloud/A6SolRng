-- TAB 3 — AUTO BOSS
-- Nguồn: findingdulcinea.com, techwiser.com raid hell guide
-- Bay lên → spam abilities → bám boss
-- ============================================================

local BOSS_KEYS   = {"Boss","SandWorm","Crawler","Amalgamation","RaidBoss","Worm"}
local ABILITY_KEYS= {"UseAbility","Skill1","Skill2","Skill3","AttackBoss","FireAbility","UseSkill","BossAttack"}
local FLY_H = 85

local function GetBoss()
    for _, k in ipairs(BOSS_KEYS) do
        local p=GetNPCPart(k); if p then return p end
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") then
            local h=v:FindFirstChildOfClass("Humanoid")
            if h and h.MaxHealth>500 and h.Health>0 then
                local bp=v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                if bp then return bp end
            end
        end
    end
end

local function Fly(on)
    Hum.PlatformStand=on
    local bv=Root:FindFirstChild("__AxiomBV")
    if on and not bv then
        bv=Instance.new("BodyVelocity"); bv.Name="__AxiomBV"
        bv.MaxForce=Vector3.one*1e9; bv.Velocity=Vector3.zero; bv.Parent=Root
    elseif not on and bv then bv:Destroy() end
end

local function AutoBossLoop()
    local boss=GetBoss()
    if not boss then S.Boss=false; warn("[Axiom] Không thấy boss boss man"); return end
    Fly(true)
    while S.Boss do
        boss=GetBoss(); if not boss then break end
        local bp=boss.Position
        Root.CFrame=CFrame.new(bp.X, bp.Y+FLY_H, bp.Z)
            *CFrame.Angles(0,math.rad(math.random(0,360)),0)
        Root.CFrame=CFrame.lookAt(Root.Position, Vector3.new(bp.X, Root.Position.Y-1, bp.Z))
        for _,a in ipairs(ABILITY_KEYS) do pcall(FireR,a); pcall(FireR,a,boss.Parent) end
        task.wait(0.15)
    end
    Fly(false)
end

