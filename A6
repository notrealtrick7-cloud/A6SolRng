local function GetNPCPart(kw)
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:lower():find(kw:lower()) then
            return v.PrimaryPart or v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
        end
    end
end

local function WalkTo(pos)
    if not (Hum and Hum.Health > 0) then return end
    Hum:MoveTo(pos)
    local done = false
    local c = Hum.MoveToFinished:Connect(function() done=true end)
    local t = 0; while not done and t < 10 do task.wait(0.1); t=t+0.1 end; c:Disconnect()
end

local function FireR(name, ...)
    local r = ReplicatedStorage:FindFirstChild(name,true) or Workspace:FindFirstChild(name,true)
    if not r then return end
    if r:IsA("RemoteEvent") then r:FireServer(...) end
    if r:IsA("RemoteFunction") then return r:InvokeServer(...) end
end

local function PressP(kw)
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if (v.ActionText..v.ObjectText):lower():find(kw:lower()) then
                pcall(fireproximityprompt, v); return true
            end
        end
    end
end

local function CheckPass(id)
    local ok, r = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(LP.UserId, id) end)
    return ok and r
end

