local function DoQuestBoard()
    local jake=GetNPCPart("Jake")
    if jake then WalkTo(jake.Position+Vector3.new(6,0,6)) end
    task.wait(0.4); PressP("QuestBoard"); PressP("Quest Board"); task.wait(0.3)
    for i=1,3 do FireR("AcceptBoardQuest",i); FireR("TakeBoardQuest",i); task.wait(0.3) end
    task.wait(0.5)
    for _=1,5 do
        FireR("CompleteBoardQuest"); FireR("TurnInQuest")
        FireR("ClaimQuestReward"); FireR("ClaimBoardReward"); task.wait(0.4)
    end
end

local function AutoQuestLoop()
    while S.Quest do
        DoDailyQuest(); task.wait(1); DoQuestBoard(); task.wait(5)
    end
end

