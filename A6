-- Checkbox list cho craft
local function MkCheckList(pg, items, selKey, headerTxt, startOrd)
    MkLbl(pg, headerTxt, startOrd, Color3.fromRGB(200,150,255))
    for i, item in ipairs(items) do
        local f=Instance.new("Frame",pg); f.Size=UDim2.new(1,-2,0,26)
        f.BackgroundColor3=Color3.fromRGB(13,5,25); f.BorderSizePixel=0; f.LayoutOrder=startOrd+i
        Instance.new("UICorner",f).CornerRadius=UDim.new(0,6)
        local l=Instance.new("TextLabel",f); l.Size=UDim2.new(0.78,0,1,0); l.Position=UDim2.new(0,28,0,0)
        l.BackgroundTransparency=1; l.TextScaled=true; l.Font=Enum.Font.Gotham
        l.TextColor3=Color3.fromRGB(200,185,240); l.TextXAlignment=Enum.TextXAlignment.Left
        l.Text=item.name.." | "..item.effect
        local cb=Instance.new("TextButton",f); cb.Size=UDim2.new(0,20,0,20)
        cb.Position=UDim2.new(0,4,0.5,-10); cb.BackgroundColor3=Color3.fromRGB(30,10,60)
        cb.Text=""; cb.Font=Enum.Font.GothamBold; cb.TextScaled=true
        Instance.new("UICorner",cb).CornerRadius=UDim.new(0,4)
        local checked=false
        local function toggle()
            checked=not checked
            cb.BackgroundColor3=checked and Color3.fromRGB(80,200,100) or Color3.fromRGB(30,10,60)
            cb.Text=checked and "✓" or ""
            cb.TextColor3=Color3.fromRGB(10,10,10)
            local sel=S[selKey]
            if checked then
                local found=false
                for _,v in ipairs(sel) do if v==item.name then found=true; break end end
                if not found then table.insert(sel,item.name) end
            else
                for i2,v in ipairs(sel) do if v==item.name then table.remove(sel,i2); break end end
            end
        end
        cb.MouseButton1Click:Connect(toggle)
    end
end

