end

local function MkToggle(pg,lbl,key,cb,ord)
    local f=Instance.new("Frame",pg); f.Size=UDim2.new(1,-2,0,34)
    f.BackgroundColor3=Color3.fromRGB(15,6,30); f.BorderSizePixel=0; f.LayoutOrder=ord or 0
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,7)
    local l=Instance.new("TextLabel",f); l.Size=UDim2.new(0.72,0,1,0); l.Position=UDim2.new(0,8,0,0)
    l.BackgroundTransparency=1; l.Text=lbl; l.TextScaled=true; l.Font=Enum.Font.Gotham
    l.TextColor3=Color3.fromRGB(200,185,240); l.TextXAlignment=Enum.TextXAlignment.Left
    local b=Instance.new("TextButton",f); b.Size=UDim2.new(0,55,0,22)
    b.Position=UDim2.new(1,-60,0.5,-11); b.BackgroundColor3=Color3.fromRGB(40,40,50)
    b.Text="OFF"; b.TextColor3=Color3.fromRGB(180,180,180); b.Font=Enum.Font.GothamBold; b.TextScaled=true
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,5)
    local function rf()
        local on=S[key]
        b.BackgroundColor3=on and Color3.fromRGB(50,195,85) or Color3.fromRGB(40,40,50)
        b.Text=on and "ON" or "OFF"
        b.TextColor3=on and Color3.fromRGB(10,10,10) or Color3.fromRGB(180,180,180)
    end
    b.MouseButton1Click:Connect(function() S[key]=not S[key]; rf(); if cb then cb(S[key]) end end)
end

local function MkBtn(pg,txt,cb,ord)
    local b=Instance.new("TextButton",pg); b.Size=UDim2.new(1,-2,0,34); b.LayoutOrder=ord or 0
    b.BackgroundColor3=Color3.fromRGB(42,12,95); b.BorderSizePixel=0
